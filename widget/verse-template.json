{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "selectAction": { "type": "Action.OpenUrl", "url": "${url}" },
  "body": [
    { "type": "TextBlock", "text": "${title}", "size": "Small", "weight": "Bolder", "isSubtle": true, "wrap": true },
    { "type": "TextBlock", "text": "${verse}", "size": "Medium", "wrap": true, "maxLines": 6 },
    { "type": "TextBlock", "text": "${ref}", "size": "Small", "weight": "Bolder", "horizontalAlignment": "Right", "wrap": true }
  ]
}
